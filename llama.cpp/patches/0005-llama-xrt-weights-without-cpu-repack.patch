# Apply with: git apply <patch>  (from the root of llama.cpp commit c92e806d1c81091c9035edce99c35374da1b465e)
diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 7dea38c..e05fbd4 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -1244,10 +1244,15 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
 
     // build a list of buffer types for the CPU and GPU devices
     pimpl->cpu_buft_list = make_cpu_buft_list(devices, params.use_extra_bufts, params.no_host);
+    // fpga-llama-gguf: the XRT backend reads the weights of its layers from host memory in GGUF layout, so their
+    // fallback list leaves out the CPU repack buffers (Q4_0 would otherwise be repacked and stay on the CPU).
+    const buft_list_t xrt_cpu_buft_list = make_cpu_buft_list(devices, false, params.no_host);
     for (const auto & dev : devices) {
         buft_list_t buft_list = make_gpu_buft_list(dev.dev, split_mode, tensor_split);
         // add CPU buffer types as a fallback
-        buft_list.insert(buft_list.end(), pimpl->cpu_buft_list.begin(), pimpl->cpu_buft_list.end());
+        const bool xrt = strstr(ggml_backend_dev_name(dev.dev), "_XRT") != nullptr;
+        const buft_list_t & cpu_list = xrt ? xrt_cpu_buft_list : pimpl->cpu_buft_list;
+        buft_list.insert(buft_list.end(), cpu_list.begin(), cpu_list.end());
         pimpl->gpu_buft_list.emplace(dev.dev, std::move(buft_list));
     }
 
