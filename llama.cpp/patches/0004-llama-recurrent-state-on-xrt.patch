diff --git a/src/llama-memory-recurrent.cpp b/src/llama-memory-recurrent.cpp
index 3d6c6db..4c99483 100644
--- a/src/llama-memory-recurrent.cpp
+++ b/src/llama-memory-recurrent.cpp
@@ -5,6 +5,9 @@
 #include "llama-io.h"
 #include "llama-batch.h"
 #include "llama-model.h"
+#ifdef GGML_USE_XRT
+#include "ggml-xrt.h"
+#endif
 
 #include <algorithm>
 #include <cassert>
@@ -85,6 +88,12 @@ llama_memory_recurrent::llama_memory_recurrent(
         if (offload) {
             auto * dev = model.dev_layer(i);
             buft = ggml_backend_dev_buffer_type(dev);
+#ifdef GGML_USE_XRT
+            // fpga-llama-gguf: a gemvqc16 kernel with DeltaNet opcodes keeps the recurrent states on the card.
+            if (auto * xrt_rs = ggml_backend_xrt_rs_buffer_type(dev)) {
+                buft = xrt_rs;
+            }
+#endif
 
             dev_name = ggml_backend_dev_name(dev);
         }
